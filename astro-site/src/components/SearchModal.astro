---
// Buscador del sitio en un modal. Usa Pagefind: un índice estático que se genera al
// compilar (npm run build) y se sirve en /pagefind/. No necesita servidor ni claves.
// Cualquier elemento con [data-search-open] lo abre; también Ctrl/Cmd + K.
// Header, footer, pre-footer y modales llevan data-pagefind-ignore para que el
// índice contenga solo el contenido propio de cada página.
---

<dialog
  id="search-dialog"
  data-pagefind-ignore
  aria-label="Search the site"
  class="m-0 mx-auto mt-[8vh] max-h-[80vh] w-[min(92vw,720px)] overflow-hidden rounded-2xl bg-white p-0 text-brand-ink shadow-2xl backdrop:bg-black/50"
>
  <div class="flex max-h-[80vh] flex-col">
    <form method="dialog" class="flex items-center gap-3 border-b border-stone-200 px-5 py-4" data-search-form>
      <svg class="h-5 w-5 shrink-0 text-brand-rust" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search treatments, doctors, referrals…"
        autocomplete="off"
        aria-label="Search the site"
        class="min-w-0 flex-1 border-0 bg-transparent text-lg text-brand-ink placeholder:text-brand-ink/50 focus:outline-none"
      />
      <button type="submit" aria-label="Close search" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xl leading-none text-brand-ink/70 transition hover:bg-stone-100">×</button>
    </form>
    <p id="search-status" class="px-5 pt-4 text-sm text-brand-ink/70" role="status" aria-live="polite">Type at least 2 letters to search.</p>
    <ul id="search-results" class="overflow-y-auto px-2 pb-3 pt-2 [&_mark]:rounded [&_mark]:bg-brand-rust/15 [&_mark]:px-0.5 [&_mark]:text-brand-rust"></ul>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const status = document.getElementById('search-status') as HTMLElement;

  let pagefind: any = null;
  async function loadIndex() {
    if (pagefind) return pagefind;
    try {
      // import() por Function para que Vite no lo reescriba (el archivo vive en /public)
      const importer = new Function('url', 'return import(url)');
      pagefind = await importer('/pagefind/pagefind.js');
      await pagefind.options({ baseUrl: '/' });
    } catch (error) {
      console.warn('Search index not available (it is generated by `npm run build`).', error);
      pagefind = null;
    }
    return pagefind;
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.focus();
    input.select();
    loadIndex();
  }

  async function run(query: string) {
    const q = query.trim();
    list.replaceChildren();
    if (q.length < 2) {
      status.textContent = 'Type at least 2 letters to search.';
      return;
    }
    const pf = await loadIndex();
    if (!pf) {
      status.textContent = "Search isn't available right now. Please try again later.";
      return;
    }
    const search = await pf.debouncedSearch(q, {}, 200);
    if (search === null) return; // llegó una búsqueda más nueva
    if (!search.results.length) {
      status.textContent = `No results for "${q}".`;
      return;
    }
    const top = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
    status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'}${search.results.length > 8 ? ' (showing the first 8)' : ''}.`;
    for (const item of top) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = item.url;
      a.className = 'block rounded-xl px-4 py-3 transition hover:bg-[#f2eeea] focus-visible:bg-[#f2eeea]';
      const title = document.createElement('span');
      title.className = 'block font-heading text-base font-semibold text-brand-rust';
      title.textContent = item.meta?.title ?? item.url;
      const excerpt = document.createElement('span');
      excerpt.className = 'mt-1 block text-base text-brand-ink/80';
      excerpt.innerHTML = item.excerpt; // Pagefind escapa el HTML y solo agrega <mark>
      const path = document.createElement('span');
      path.className = 'mt-1 block text-sm text-brand-ink/50';
      path.textContent = item.url;
      a.append(title, excerpt, path);
      li.append(a);
      list.append(li);
    }
  }

  input.addEventListener('input', () => run(input.value));
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-search-open]')) open();
  });
  // Cerrar al hacer click en el fondo oscuro o al navegar a un resultado
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
    if ((e.target as HTMLElement).closest('a')) dialog.close();
  });
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      open();
    }
  });
</script>
