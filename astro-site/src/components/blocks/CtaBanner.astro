---
interface Props {
  heading: string;
  label: string;
  url: string;
}
const { heading, label, url } = Astro.props;
---

<section class="bg-brand-rust py-14 text-center text-white reveal">
  <h2 class="text-2xl font-semibold">{heading}</h2>
  <a href={url} class="mt-6 inline-block rounded-full bg-white px-8 py-3 font-medium text-brand-rust transition hover:bg-stone-100">
    {label}
  </a>
</section>
