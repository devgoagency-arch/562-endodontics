---
interface Props {
  heading: string;
  text?: string;
  image?: string;
  ctaLabel?: string;
  ctaUrl?: string;
}
const { heading, text, image, ctaLabel, ctaUrl } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-rustDark text-white">
  {image && (
    <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" loading="eager" />
  )}
  <div class="relative mx-auto max-w-5xl px-6 py-24 text-center reveal">
    <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">{heading}</h1>
    {text && <p class="mt-4 text-lg text-white/85">{text}</p>}
    {ctaLabel && ctaUrl && (
      <a href={ctaUrl} class="mt-8 inline-block rounded-full bg-brand-rust px-8 py-3 font-medium text-white transition hover:bg-brand-rustDark">
        {ctaLabel}
      </a>
    )}
  </div>
</section>
