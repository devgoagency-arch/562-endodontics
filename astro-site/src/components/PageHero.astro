---
// Banner de título para páginas internas (Referrals, Endodontic Treatments,
// High Tech Facility, etc.) — un solo componente para que el alto y el
// tratamiento de la foto queden consistentes en todo el sitio sin tener que
// repetir/recordar los valores en cada página nueva.
interface Props {
  title: string;
  image: string;
}
const { title, image } = Astro.props;
---

<section class="relative flex min-h-[560px] items-center justify-center overflow-hidden bg-brand-rustDark py-28 text-center text-white">
  <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover" loading="eager" />
  <div class="absolute inset-0 bg-gradient-to-b from-brand-rust/60 via-brand-rust/50 to-brand-rustDark/70" aria-hidden="true"></div>
  <h1 class="relative font-heading text-4xl font-light leading-tight sm:text-[43px]">{title}</h1>
</section>
