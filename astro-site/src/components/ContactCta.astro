---
// Pre-footer compartido: "Give your patients exceptional endodontic care" +
// formulario de contacto. Vive en Home y en todas las páginas internas
// (páginas de tratamiento, etc.) — de ahí que sea su propio componente en
// vez de código repetido. El ancla #form es a donde apuntan los botones
// "Contact Us" de otras páginas.
import ContactForm from './ContactForm.astro';
---

<section id="form" class="scroll-mt-24 bg-[#f2eeea] py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-2">
    <div class="reveal">
      <h2 class="reveal font-heading text-3xl font-light leading-tight text-brand-ink sm:text-[43px]">
        Give your patients exceptional endodontic care
      </h2>
      <p class="mt-5 text-lg text-brand-ink/70">
        At 562 endodontics we are committed to helping each patient with their dental health and
        well-being through personalized diagnosis and procedures. We strive to make their experience
        as comfortable and stress-free as possible while delivering the highest quality care available.
      </p>
      <div class="mt-7 rounded-xl border border-brand-rust/20 bg-brand-rust/5 p-6 text-base">
        <p class="font-heading font-semibold text-brand-rust">For urgent dental trauma:</p>
        <ul class="mt-3 space-y-1.5 text-brand-ink/80">
          <li>Call 562 endodontics at <a href="tel:+15196013636" class="font-semibold hover:underline">(519) 601-3636</a></li>
          <li>Email: <a href="mailto:info@562endodontics.com" class="font-semibold hover:underline">info@562endodontics.com</a></li>
          <li>Online referral form at <a href="/referrals" class="font-semibold hover:underline">562endodontics.com/referrals</a></li>
        </ul>
      </div>
      <p class="mt-6 text-base text-brand-ink/70">
        We are located at <a href="https://www.google.com/maps/place/562+Waterloo+St,+London,+ON+N6B+2P9" target="_blank" rel="noopener" class="font-semibold hover:underline">562 Waterloo Street, London, Ontario</a>.
        Dedicated patient parking is available behind the building, marked "DENTAL."
      </p>
      <p class="mt-2 text-base text-brand-ink/70">
        We serve the community throughout London and Middlesex County.
      </p>
    </div>

    <ContactForm heading="Send us a message" class="reveal rounded-2xl border border-stone-200 p-7" />
  </div>
</section>
