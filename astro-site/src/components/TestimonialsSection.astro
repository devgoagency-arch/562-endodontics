---
// Reviews de Google. Los datos se mantienen a mano en src/data/reviews.ts (ahí
// están las instrucciones para la actualización mensual).
import { reviews, summary, SHOW_COUNT, GOOGLE_REVIEWS_URL } from '../data/reviews';

const items = reviews.slice(0, SHOW_COUNT);
const monthYear = (value?: string) =>
  value ? new Date(`${value}-15`).toLocaleDateString('en-CA', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : 'Google review';
---

<section class="bg-white py-24 text-center">
  <div class="mx-auto max-w-6xl px-6">
    <p class="reveal font-heading text-sm font-semibold uppercase tracking-wide text-brand-rust">Testimonials</p>
    <h2 class="reveal mt-2 font-heading text-4xl font-light leading-tight text-brand-ink sm:text-[43px]">What Patients Say About Us</h2>

    <!-- Resumen de Google: nota, total y enlace a la ficha -->
    <a
      href={GOOGLE_REVIEWS_URL}
      target="_blank"
      rel="noopener"
      class="reveal mx-auto mt-8 inline-flex flex-wrap items-center justify-center gap-x-5 gap-y-2 rounded-2xl border border-stone-200 bg-white px-6 py-4 shadow-sm transition hover:shadow-md"
    >
      <img src="/images/logos/google-reviews-logo.svg" alt="Google Reviews" class="h-10 w-auto" />
      <span class="flex items-center gap-2">
        <span class="font-heading text-3xl font-semibold text-brand-ink">{summary.rating.toFixed(1)}</span>
        <span class="text-xl tracking-wide text-brand-rust" aria-hidden="true">★★★★★</span>
      </span>
      <span class="text-base text-brand-ink/80">{summary.count} reviews on Google</span>
    </a>

    <!-- flex + wrap (no grid) a propósito: centra cualquier fila incompleta,
         sea cual sea el total de reseñas. -->
    <div class="mt-12 flex flex-wrap justify-center gap-6">
      {items.map((t) => (
        <article class="reveal flex w-full flex-col rounded-2xl border border-stone-200 p-7 text-left shadow-sm md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
          <div class="flex items-center gap-3">
            {t.avatar ? (
              <img src={t.avatar} alt="" class="h-10 w-10 rounded-full object-cover" loading="lazy" />
            ) : (
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-rust/10 font-heading text-sm font-semibold text-brand-rust" aria-hidden="true">
                {t.author.charAt(0)}
              </span>
            )}
            <div>
              <span class="block font-heading text-base font-semibold text-brand-ink">{t.author}</span>
              <span class="block text-sm text-brand-ink/60">{monthYear(t.date)}</span>
            </div>
          </div>
          <div class="mt-3 flex gap-1 text-brand-rust" role="img" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: t.rating }).map(() => <span aria-hidden="true">★</span>)}
          </div>
          <p class="mt-3 line-clamp-6 text-base text-brand-ink/80">{t.text}</p>
          <a href={t.url ?? GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="mt-auto inline-block pt-4 text-sm font-semibold text-brand-rust hover:underline">
            Read on Google
          </a>
        </article>
      ))}
    </div>

    <a
      href={GOOGLE_REVIEWS_URL}
      target="_blank"
      rel="noopener"
      class="reveal mt-10 inline-flex items-center rounded-[20px_20px_3px_3px] bg-brand-rust px-8 py-3 font-heading text-sm font-semibold uppercase tracking-wide text-white transition hover:bg-brand-rustDark"
    >
      See all {summary.count} reviews on Google
    </a>
  </div>
</section>
