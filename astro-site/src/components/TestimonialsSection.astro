---
// Testimonios: hoy vienen del CPT `testimonial` (respaldo editorial). El
// upgrade natural más adelante es reemplazar esta consulta por la API de
// Google Places para halar reseñas reales en vivo sin curaduría manual.
import { wp, GET_TESTIMONIALS } from '../lib/wordpress';

// Reseñas reales tomadas del sitio en vivo (Google Reviews), como respaldo
// mientras el CPT `testimonial` en WordPress no tenga contenido propio.
// Una vez conectado el CMS real, estas quedan reemplazadas automáticamente.
const FALLBACK_TESTIMONIALS = [
  {
    author: 'Jodi Hall',
    rating: 5,
    avatar: '/images/testimonials/jodi-hall.png',
    sourceUrl: 'https://maps.app.goo.gl/nEGgn4WY9JRtnSSHA',
    content: "I recently had a root canal at 562 Endodontics, and I honestly can't say enough to sing their praises. From the professionalism and warmth of the office staff and dental hygienists, to the care provided by Dr. Lopez Gross, I was so pleased with my experience.",
  },
  {
    author: 'Rob Ure',
    rating: 5,
    avatar: '/images/testimonials/rob-ure.png',
    sourceUrl: 'https://maps.app.goo.gl/VPPtbJ3qocV2gxji9',
    content: 'Dr. Carr was fantastic - the staff were phenomenal - nervous as I was, I was put at ease from the moment I walked in. Highly recommend these fantastic people.',
  },
  {
    author: 'louise simler',
    rating: 5,
    avatar: '/images/testimonials/louise-simler.png',
    sourceUrl: 'https://maps.app.goo.gl/qtimFzSkS2DRuaJy5',
    content: "My experience here was amazing. I was a total wreck going in. I'm not a fan of the dentist, but the people here were amazing. They made me feel so at ease.",
  },
  {
    author: 'Ryan Allison',
    rating: 5,
    avatar: '/images/testimonials/ryan-allison.png',
    sourceUrl: 'https://maps.app.goo.gl/S6HN51FdyaE9Bcs46',
    content: 'Having a Root Canal is an unpleasant experience, but the warmth and care from everyone in this clinic made this a very positive experience. Excellent bedside manner from everyone at this professional and well-equipped clinic.',
  },
  {
    author: 'Kathleen Gunther',
    rating: 5,
    avatar: '/images/testimonials/kathleen-gunther.png',
    sourceUrl: 'https://maps.app.goo.gl/tKtKxkZ7S1WMgo1r9',
    content: 'What a great team! Sam at the front desk is excellence in customer service personified; Lisa, who did my xrays and assisted the doctor, was so attentive; and Dr. Lopez was friendly and professional.',
  },
];

let testimonials: any[] = [];
try {
  const data = await wp.request<{ testimonials: { nodes: any[] } }>(GET_TESTIMONIALS);
  testimonials = data.testimonials.nodes;
} catch {
  testimonials = [];
}

const items = testimonials.length > 0
  ? testimonials.map((t) => ({
      author: t.testimonialFields?.author ?? t.title,
      rating: t.testimonialFields?.rating ?? 5,
      content: t.content,
      sourceUrl: t.testimonialFields?.sourceUrl,
      avatar: null,
    }))
  : FALLBACK_TESTIMONIALS;
---

<section class="bg-white py-24 text-center">
  <div class="mx-auto max-w-6xl px-6">
  <p class="reveal font-heading text-sm font-semibold uppercase tracking-wide text-brand-rust">Testimonials</p>
  <h2 class="reveal mt-2 font-heading text-4xl font-light leading-tight text-brand-ink sm:text-[43px]">What Patients Say About Us</h2>

  <!-- flex + wrap (no grid) a propósito: con 5 tarjetas un grid de 3 columnas
       deja las últimas 2 pegadas a la izquierda; flex-wrap + justify-center
       centra cualquier fila incompleta, sea cual sea el total de reseñas. -->
  <div class="mt-12 flex flex-wrap justify-center gap-6">
    {items.map((t) => (
      <article class="reveal w-full rounded-2xl border border-stone-200 p-7 text-left shadow-sm md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
        <div class="flex items-center gap-3">
          {t.avatar ? (
            <img src={t.avatar} alt={t.author} class="h-10 w-10 rounded-full object-cover" loading="lazy" />
          ) : (
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-rust/10 font-heading text-sm font-semibold text-brand-rust">
              {t.author.charAt(0)}
            </span>
          )}
          <div>
            <span class="block font-heading text-sm font-semibold text-brand-ink">{t.author}</span>
            <span class="block text-xs text-brand-ink/50">reviewed 562 endodontics</span>
          </div>
        </div>
        <div class="mt-3 flex gap-1 text-brand-rust" aria-hidden="true">
          {Array.from({ length: t.rating }).map(() => <span>★</span>)}
        </div>
        <p class="mt-3 text-base text-brand-ink/80" set:html={t.content} />
        {t.sourceUrl && (
          <a href={t.sourceUrl} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-semibold text-brand-rust hover:underline">
            View on Google
          </a>
        )}
      </article>
    ))}
  </div>
  </div>
</section>
