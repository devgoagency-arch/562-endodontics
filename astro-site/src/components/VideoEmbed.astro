---
// Portada de video: muestra la miniatura original (la de YouTube, o el poster
// indicado) sin taparla: el botón de play es compacto y va abajo a la izquierda,
// como el de YouTube. Al hacer click abre el modal de video del sitio
// (VideoModal, incluido en BaseLayout). No carga ningún reproductor hasta el
// click.
interface Props {
  title: string;
  youtube?: string; // ID del video
  mp4?: string;
  poster?: string;
  class?: string;
}
const { title, youtube, mp4, poster, class: className = '' } = Astro.props;
const thumb = poster ?? (youtube ? `https://i.ytimg.com/vi/${youtube}/hqdefault.jpg` : '');
---

<button
  type="button"
  class={`group relative block aspect-video w-full cursor-pointer overflow-hidden rounded-[20px] bg-black ${className}`}
  data-video-trigger
  data-video-youtube={youtube ?? ''}
  data-video-mp4={mp4 ?? ''}
  data-video-title={title}
  aria-label={`Play video: ${title}`}
>
  {thumb && <img src={thumb} alt="" class="h-full w-full object-cover" loading="lazy" />}
  <span class="absolute bottom-3 left-3 flex h-11 w-11 items-center justify-center rounded-full border border-stone-300 bg-white/95 shadow-lg transition group-hover:scale-110 group-hover:bg-white">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 text-brand-rust" aria-hidden="true"><path d="M8 5v14l11-7Z" /></svg>
  </span>
</button>
