---
interface Props {
  label: string;
  text: string;
  icon: 'pin' | 'clock' | 'phone';
  href?: string;
}
const { label, text, icon, href } = Astro.props;

const icons: Record<Props['icon'], string> = {
  pin: 'M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z M12 11.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  clock: 'M12 8v4l3 2 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  phone: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z',
};

const Tag = href ? 'a' : 'div';
const isExternal = href?.startsWith('http');
---

<Tag href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined} class="flex items-center gap-3 transition hover:opacity-80">
  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-rust text-white">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={`<path d="${icons[icon]}" />`} />
  </span>
  <span>
    <span class="block font-heading text-sm font-semibold uppercase tracking-wide text-brand-ink">{label}</span>
    <span class="block whitespace-pre-line text-sm text-brand-ink/70">{text}</span>
  </span>
</Tag>
