---
const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Our Dental Clinic', href: '/our-clinic' },
  { label: 'Endodontic Treatments', href: '/endodontic-treatments' },
  { label: 'High Tech Facility', href: '/high-tech-facility' },
  { label: 'Professional Development', href: '/professional-development' },
  { label: 'Referrals', href: '/referrals' },
  { label: 'Contact Us', href: '/contact-us' },
];
---

<!-- Fondo confirmado contra el original: rgb(177,62,37) = brand-rust exacto,
     no un gris/azul oscuro genérico. -->
<footer class="bg-brand-rust pb-24 pt-16 text-white/85 lg:pb-16">

  <!-- Newsletter: el original tenía texto Lorem Ipsum sin terminar aquí;
       se reemplaza por copy real. -->
  <div class="mx-auto mb-14 max-w-3xl border-b border-white/15 px-6 pb-14 text-center">
    <h3 class="font-heading text-xl font-semibold text-white">Subscribe to Our Newsletter</h3>
    <p class="mt-2 text-base text-white/80">
      Get updates on new treatments, professional development events, and news from 562 endodontics.
    </p>
    <form class="mx-auto mt-5 flex max-w-md flex-col gap-3 sm:flex-row" action="/api/subscribe" method="post">
      <input
        type="email"
        name="email"
        placeholder="Your Email Address"
        required
        class="w-full rounded-full border border-white/30 bg-white/10 px-5 py-3 text-base text-white placeholder:text-white/60 focus:bg-white/15"
      />
      <button type="submit" class="shrink-0 rounded-full bg-white px-7 py-3 font-heading text-sm font-semibold text-brand-rust transition hover:bg-stone-100">
        Subscribe
      </button>
    </form>
  </div>

  <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-4">
    <div>
      <img src="/logo/logo-white.png" alt="562 endodontics" class="h-14 w-auto" />
      <p class="mt-4 text-base leading-relaxed">
        At 562 endodontics, our mission is to promote the benefit of preserving natural teeth while
        serving and inspiring the dental community for best practices in customer care and endodontics.
      </p>
      <div class="mt-5 flex gap-3">
        <!-- TODO: falta la URL real de Facebook (el original la arma con un
             ID de perfil que no quedó registrado en la auditoría) -->
        <a href="#" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.51 17.52 2 12 2S2 6.51 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z"/></svg>
        </a>
        <a href="https://www.instagram.com/562endodontics/" target="_blank" rel="noopener" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/jacqueline-lopez-gross-dds-msc-frcd-c-2041102/" target="_blank" rel="noopener" aria-label="LinkedIn" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/15 transition hover:bg-white/25">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.84v1.54h.05c.53-1 1.85-2.06 3.8-2.06 4.07 0 4.81 2.68 4.81 6.16V21h-4v-4.87c0-1.16-.02-2.65-1.62-2.65-1.62 0-1.87 1.27-1.87 2.57V21h-4V9.75Z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-heading text-base font-semibold uppercase tracking-wide text-white">Quick Links</h3>
      <ul class="mt-4 space-y-2 text-base">
        {quickLinks.map((l) => <li><a href={l.href} class="transition hover:text-white hover:underline">{l.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3 class="font-heading text-base font-semibold uppercase tracking-wide text-white">Contact Details</h3>
      <ul class="mt-4 space-y-2 text-base">
        <li><a href="https://www.google.com/maps/place/562+Waterloo+St,+London,+ON+N6B+2P9" target="_blank" rel="noopener" class="transition hover:text-white hover:underline">562 Waterloo st, London, ON, N6B 2P9</a></li>
        <li><a href="mailto:info@562endodontics.com" class="transition hover:text-white hover:underline">info@562endodontics.com</a></li>
        <li><a href="tel:+15196013636" class="transition hover:text-white hover:underline">(519) 601 - ENDO (3636)</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-heading text-base font-semibold uppercase tracking-wide text-white">Work Hours</h3>
      <p class="mt-4 text-base">Mon, Tue, Thu &amp; Fri: 8:30am–5pm<br />Wed: 8:30am–4pm</p>
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-7xl border-t border-white/15 px-6 pt-6 text-sm text-white/60">
    Copyright © {new Date().getFullYear()} All rights reserved. <a href="/privacy-policy" class="ml-3 underline transition hover:text-white">Privacy Policy</a>
  </div>
</footer>
