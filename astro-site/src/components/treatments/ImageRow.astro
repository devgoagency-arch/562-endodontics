---
// Fila "imagen a la izquierda + texto a la derecha" (H3 + párrafo/lista).
// Se repite en todas las páginas de tratamiento: imagen ≈ 21 % / texto ≈ 79 %.
import SplitSection from './SplitSection.astro';

interface Props {
  imageSrc: string;
  imageAlt: string;
  imageAspect?: string;
  py?: string;
}
const { imageSrc, imageAlt, imageAspect = 'aspect-square', py } = Astro.props;
---

<SplitSection
  imageSrc={imageSrc}
  imageAlt={imageAlt}
  imagePosition="left"
  imageAspect={imageAspect}
  gridCols="md:grid-cols-[21.3fr_78.7fr]"
  imageCols="md:col-start-1"
  textCols="md:col-start-2"
  py={py}
>
  <slot />
</SplitSection>
