---
// FAQ de página de tratamiento. A diferencia del original en WordPress, la
// respuesta NO repite la pregunta (era redundante) y el primer ítem viene
// abierto por defecto. Las respuestas admiten HTML inline (mailto/tel) y se
// emite el schema FAQPage para resultados enriquecidos.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
  })),
};
---

<div class="mx-auto max-w-3xl divide-y divide-brand-rust/15 text-left">
  {items.map((item, i) => (
    <details class="group py-5" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left font-heading text-lg font-semibold text-brand-rust">
        {item.q}
        <span class="mt-0.5 shrink-0 text-xl leading-none transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 text-left text-lg leading-relaxed text-brand-ink/80" set:html={item.a} />
    </details>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
