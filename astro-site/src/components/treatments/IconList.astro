---
// Lista con íconos beige (#C7B4A1) dentro de un círculo suave. Ícono por
// nombre; el texto admite HTML inline.
interface Props {
  items: { icon: keyof typeof ICONS; text: string }[];
}
const ICONS = {
  warning: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" /><path d="M12 9v4" /><path d="M12 17h.01" />',
  glass: '<path d="M6 3h12l-1.5 17a1 1 0 0 1-1 .9h-7a1 1 0 0 1-1-.9L6 3Z" /><path d="M6.6 9.5h10.8" />',
  firstaid: '<rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" /><path d="M12 11v6" /><path d="M9 14h6" />',
  search: '<circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />',
  box: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /><path d="m3.3 7 8.7 5 8.7-5" /><path d="M12 22V12" />',
  check: '<path d="M20 6 9 17l-5-5" />',
};
const { items } = Astro.props;
---

<ul class="mt-5 space-y-4">
  {items.map((item) => (
    <li class="flex items-start gap-3 text-lg text-brand-ink/80">
      <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-tan/20 text-brand-tan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[item.icon]} />
      </span>
      <span set:html={item.text} />
    </li>
  ))}
</ul>
