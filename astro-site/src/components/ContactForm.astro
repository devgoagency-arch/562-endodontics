---
// Formulario de contacto único del sitio (pre-footer de todas las páginas y
// página Contact Us). Envía por fetch a /api/contact y muestra el resultado en
// el mismo lugar. Incluye "Reason for Appointment" y un campo trampa anti-spam.
interface Props {
  id?: string;
  heading?: string;
  class?: string;
}
const { id = 'contact-form', heading, class: className = '' } = Astro.props;

const reasons = ['Referred by Dentist', 'Emergency', 'Shadowing opportunity'];
const input = 'w-full rounded-lg border border-stone-300 px-4 py-2.5 text-base placeholder:text-brand-rust/50';
---

<form id={id} data-async-form class={`space-y-4 ${className}`} action="/api/contact" method="post">
  {heading && <h3 class="font-heading text-base font-semibold uppercase tracking-wide text-brand-ink">{heading}</h3>}
  <div class="grid gap-4 sm:grid-cols-2">
    <input type="text" name="first_name" placeholder="First Name" required autocomplete="given-name" class={input} />
    <input type="text" name="last_name" placeholder="Last Name" required autocomplete="family-name" class={input} />
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <input type="tel" name="phone" placeholder="Phone" required autocomplete="tel" class={input} />
    <input type="email" name="email" placeholder="Email" required autocomplete="email" class={input} />
  </div>

  <fieldset>
    <legend class="font-heading text-base font-semibold text-brand-rust">Reason for Appointment:</legend>
    <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
      {reasons.map((reason) => (
        <label class="flex items-center gap-2 text-base text-brand-ink/80">
          <input type="checkbox" name="reason" value={reason} />
          {reason}
        </label>
      ))}
    </div>
  </fieldset>

  <textarea name="message" placeholder="Message" rows="4" class={input}></textarea>

  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

  <label class="flex items-start gap-2 text-sm text-brand-ink/70">
    <input type="checkbox" name="consent" required class="mt-0.5" />
    <span>I acknowledge that I agree to the Terms of Use and have read the <a href="/privacy-policy" class="underline">Privacy Policy</a></span>
  </label>
  <label class="flex items-start gap-2 text-sm text-brand-ink/70">
    <input type="checkbox" name="newsletter" class="mt-0.5" />
    <span>I want to receive by email new features, events, research and relevant information from 562 endodontics.</span>
  </label>
  <button type="submit" class="w-full rounded-full bg-brand-rust py-3.5 font-heading text-base font-semibold uppercase tracking-wide text-white transition hover:bg-brand-rustDark">
    Send
  </button>
  <p class="form-status hidden text-sm font-medium" role="status"></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-async-form]').forEach((form) => {
    const status = form.querySelector<HTMLParagraphElement>('.form-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!button || !status) return;
      button.disabled = true;
      button.textContent = 'Sending...';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error('Request failed');
        form.reset();
        status.textContent = "Thanks — we've received your message and will be in touch shortly.";
        status.classList.remove('hidden', 'text-red-600');
        status.classList.add('text-emerald-700');
      } catch {
        status.textContent = 'Something went wrong sending your message. Please call us at (519) 601-3636.';
        status.classList.remove('hidden', 'text-emerald-700');
        status.classList.add('text-red-600');
      } finally {
        button.disabled = false;
        button.textContent = 'Send';
      }
    });
  });
</script>
