---
// Página de tratamiento "Root Canal Treatment". Misma plantilla que Cracked Teeth y
// Dental Trauma. Textos según las correcciones del cliente (lenguaje claro para el
// paciente, manteniendo el tono profesional).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SplitSection from '../../components/treatments/SplitSection.astro';
import ImageRow from '../../components/treatments/ImageRow.astro';
import DataTable from '../../components/treatments/DataTable.astro';
import TreatmentFaq from '../../components/treatments/TreatmentFaq.astro';
import ContactCta from '../../components/ContactCta.astro';

const referralTable = {
  headers: ['Situation', 'How we help'],
  rows: [
    ['Calcified or Sclerosed Canals', 'Over time, canals can narrow or become blocked with mineral deposits, making them difficult to locate and treat. Microscope-guided techniques support precise access while reducing the risk of complications.'],
    ['Complex Canal Anatomy', 'Some teeth have unusually curved, narrow, or multiple canals that require magnification and 3D imaging for thorough assessment and careful treatment planning.'],
    ['Dental Trauma', 'Teeth that have experienced a traumatic injury such as a knock, fracture, or displacement require a prompt assessment to determine the extent of damage, establish an appropriate treatment plan, and support proper long-term monitoring.'],
    ['Previously Treated Teeth with Persistent or Recurring Infection', 'Teeth that have had a prior root canal and develop new or ongoing signs of infection present unique challenges. 3D imaging, enhanced magnification, and advanced disinfection technology support a thorough evaluation to determine whether retreatment is appropriate.'],
    ['Procedural Complications', 'Complications such as blocked canals or separated instruments can arise during root canal treatment and may require advanced management. Enhanced magnification and specialized techniques support careful assessment and management of these situations.'],
    ['Dental Anxiety', 'Patients who experience dental anxiety are welcome at our practice. We offer sedation options and take the time to create a calm, comfortable experience so that every patient feels at ease throughout their visit.'],
  ],
};

const visitTable = {
  headers: ['Topic', 'What to expect'],
  rows: [
    ['Consultation', 'A thorough clinical examination is performed, radiographs are reviewed, and a CBCT scan is taken when indicated. Diagnosis, prognosis, treatment options, fees, and any questions are addressed before any treatment begins.\nAppointment length: 30 minutes'],
    ['Treatment Appointment', 'Endodontic treatment may require more than one visit. We aim to complete treatment in a single appointment when clinically appropriate, however some situations may require additional visits.\nAppointment length: 60 to 90 minutes'],
    ['Sedation', 'For patients who experience dental anxiety, sedation options are available and tailored to individual needs. These include minimal conscious sedation with nitrous oxide or oral medication, as well as moderate sedation through IV or oral routes. Sedation needs are reviewed and arranged during the consultation appointment.'],
    ['Post-Operative Discomfort', 'Some mild discomfort is common following treatment and can generally be managed with over-the-counter pain relief.'],
    ['Return to Daily Activities', 'Most patients are able to return to their normal routine the same day.'],
    ['Return to Your Referring Dentist', 'We recommend completing the final restoration promptly following treatment to protect and seal the tooth. Many teeth that have undergone root canal treatment may require a crown to help restore function and protect the tooth.'],
  ],
};

const protocolSteps = [
  { img: '/images/treatments/root-canal/root-canal-preoperative-assessment.webp', aspect: 'aspect-square', alt: 'Doctor consulting with a patient in front of monitors', title: 'Pre-operative Assessment', text: 'All referrals begin with a dedicated consultation. We perform a clinical examination, review radiographs, and use CBCT imaging when indicated for a three-dimensional assessment. Diagnosis, prognosis, treatment options, and sedation needs are discussed, and a treatment plan is established in collaboration with the patient before they leave.' },
  { img: '/images/technology/dental-operating-microscope.webp', aspect: 'aspect-[978/1024]', alt: 'Dental operating microscope', title: 'Microscope-Guided treatment', text: 'All treatment is performed under an operating microscope, providing enhanced magnification and illumination throughout the procedure.' },
  { img: '/images/treatments/root-canal/root-canal-post-treatment-communication.webp', aspect: 'aspect-square', alt: 'Clinician typing a post-treatment report on a computer', title: 'Post-Treatment Communication', text: 'After each appointment, a clinical report is sent to the referring office. Most patients return to their general dentist for final restoration and routine follow-up care. Reassessment is available if concerns arise during or after treatment.' },
];

const faqs = [
  { q: 'How do I refer my patient to 562 endodontics?', a: 'Referrals can be made through the online referral form, CDANet, by email at <a href="mailto:info@562endodontics.com" class="font-semibold text-brand-rust hover:underline">info@562endodontics.com</a>, or by phone at <a href="tel:+15196013636" class="font-semibold text-brand-rust hover:underline">(519) 601-3636</a>. Urgent cases are usually seen the same day or within 24–48 hours.' },
  { q: 'Will a 3D CBCT scan be taken at my consultation?', a: 'If indicated, a CBCT scan may be taken during the consultation. This three-dimensional imaging provides detailed views of the tooth and surrounding structures, allowing for more precise diagnosis and treatment planning than conventional radiographs.' },
  { q: 'Will the referring dentist receive a report after treatment?', a: 'Yes. Each case generates a clinical summary, including post-operative radiographs.' },
  { q: 'What if the case is more complex than expected?', a: 'If consultation findings significantly change the treatment plan, the endodontist will contact the referring dentist before proceeding.' },
];

// El primer paso arranca justo después de la sección beige, así que lleva más aire arriba.
const FIRST_PY = 'pt-16 pb-8 lg:pt-20 lg:pb-10';
const ROW_PY = 'py-8 lg:py-10';
---

<BaseLayout
  title="Root Canal Treatment"
  description="Root canal treatment in London, Ontario with an operating microscope, in-house CBCT imaging and advanced disinfection. Referrals and patients welcome."
>
  <PageHero title="Root Canal Treatment" image={`/images/team/562-endodontics-london-ontario-endodontist-and-assistants-with-microscope.webp`} />

  <!-- S2: Intro -->
  <SplitSection imageSrc={`/images/technology/cbct-scan-patient-positioned.webp`} imageAlt="562 endodontics root canal treatment in London Ontario" imagePosition="right" bg="bg-white" imageAspect="aspect-[1080/1166]">
    <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Root canal treatment in London, Ontario</h2>
    <p class="mt-5 text-lg text-brand-ink/80">
      At 562 endodontics, we offer comprehensive endodontic care in London, Ontario, including root canal treatment and
      a range of other procedures focused on diagnosing and treating conditions of the dental pulp and surrounding
      tissues. We use an operating microscope for enhanced visualization and precision, in-house CBCT imaging when
      needed for accurate diagnosis and treatment planning, advanced disinfection technology, and enhanced local
      anesthesia techniques to support patient comfort throughout treatment.
    </p>
    <a href="#form" class="mt-7 inline-flex items-center gap-2 rounded-[20px_20px_3px_3px] bg-[#7F6E5D] px-7 py-3 font-heading text-sm font-semibold uppercase tracking-wide text-white transition hover:opacity-90">
      Contact Us <span aria-hidden="true">→</span>
    </a>
  </SplitSection>

  <!-- S3: Cuándo referir -->
  <section class="bg-[#E3DBD4] py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">When Dentists Refer Patients for Root Canal Treatment?</h2>
      <p class="mt-4 text-lg text-brand-ink/80">
        Some dental situations benefit from early assessment and timely care. If you or your patient are experiencing
        any of the following, we welcome a referral or consultation.
      </p>
      <div class="mt-8">
        <DataTable headers={referralTable.headers} rows={referralTable.rows} />
      </div>
    </div>
  </section>

  <!-- S4.1: Pasos del tratamiento -->
  {protocolSteps.map((step, i) => (
    <ImageRow imageSrc={step.img} imageAlt={step.alt} imageAspect={step.aspect} py={i === 0 ? FIRST_PY : ROW_PY}>
      <h3 class="font-heading text-2xl font-semibold text-brand-rust">{step.title}</h3>
      <p class="mt-4 text-lg text-brand-ink/80">{step.text}</p>
    </ImageRow>
  ))}

  <!-- S4.2: Conservar el diente natural -->
  <SplitSection imageSrc={`/images/team/562-endodontics-london-ontario-dr-jacqueline-lopez-gross-tooth-model.webp`} imageAlt="Dr. Jacqueline Lopez holding a tooth model" imagePosition="right" bg="bg-white" imageAspect="aspect-square" py="pt-8 pb-16 lg:pt-10 lg:pb-20">
    <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Root Canal Treatment and Saving Your Natural Tooth</h2>
    <p class="mt-5 text-lg text-brand-ink/80">
      Whenever possible, keeping your natural tooth is often a preferred option. Root canal treatment removes infection
      and addresses the source of pain, allowing your tooth to remain functional.
    </p>
    <p class="mt-4 text-lg text-brand-ink/80">
      Natural teeth are supported by a ligament that helps absorb pressure and provides feedback when you bite. This is
      not replicated by an implant or other replacement.
    </p>
    <p class="mt-4 text-lg text-brand-ink/80">
      When a tooth is healthy enough to be restored, endodontic treatment is generally considered an appropriate
      approach. Extraction is considered when a tooth is too damaged or broken down to be saved. Replacing a missing
      tooth with an implant is a viable option in those situations, but it involves surgery, a healing period, and
      additional costs.
    </p>
    <p class="mt-4 text-lg text-brand-ink/80">
      We take the time to assess each tooth carefully and discuss all available options with you, so you can make an
      informed decision about your care.
    </p>
  </SplitSection>

  <!-- S5: Guía de la visita -->
  <section class="bg-[#E3DBD4] py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">A Guide to Your Endodontic Visit</h2>
      <div class="mt-8">
        <DataTable headers={visitTable.headers} rows={visitTable.rows} />
      </div>
    </div>
  </section>

  <!-- S6: FAQ -->
  <section class="bg-[#E3DBD4]/50 py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Frequently asked questions</h2>
      <div class="mt-10">
        <TreatmentFaq items={faqs} />
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
