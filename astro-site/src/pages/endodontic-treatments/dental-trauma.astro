---
// Página de tratamiento "Dental Trauma". Usa la misma plantilla que
// Cracked Teeth (PageHero, SplitSection, ImageRow, DataTable, TreatmentFaq)
// más IconList para las listas con íconos.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SplitSection from '../../components/treatments/SplitSection.astro';
import ImageRow from '../../components/treatments/ImageRow.astro';
import IntroStacked from '../../components/IntroStacked.astro';
import IconList from '../../components/treatments/IconList.astro';
import DataTable from '../../components/treatments/DataTable.astro';
import TreatmentFaq from '../../components/treatments/TreatmentFaq.astro';
import ContactCta from '../../components/ContactCta.astro';


const injuryTable = {
  headers: ['Injury type', 'Endodontic relevance', 'Referral urgency'],
  rows: [
    ['Concussion', 'Low risk of pulp necrosis (~3%). No displacement', 'Consider a referral to rule out a root fracture.'],
    ['Subluxation', 'Possible periodontal ligament injury. Necrosis risk ~6%', 'Consider a referral to rule out a root fracture.'],
    ['Extrusive luxation', 'Necrosis risk ~26% in mature teeth', 'Same-day referral recommended'],
    ['Lateral luxation', 'Necrosis risk up to 58% in mature teeth', 'Same-day or within 24 hours'],
    ['Intrusive luxation', 'Highest severity injury. Necrosis risk up to 96%', 'Immediate referral'],
    ['Root fracture', 'The endodontic prognosis depends on the location of the fracture.', 'Refer within 24–48 hours'],
    ['Alveolar fracture', 'Maxillary, mandibular fracture with multiple teeth involved', 'Same-day referral recommended to a hospital.'],
  ],
};

const splintTable = {
  headers: ['Injury', 'Splint duration'],
  rows: [
    ['Subluxation', 'Up to 2 weeks if mobility is present'],
    ['Extrusive luxation', '4 weeks'],
    ['Lateral luxation', '4 weeks'],
    ['Intrusive luxation', '4–8 weeks, depending on severity'],
    ['Root fracture', '4 weeks'],
    ['Cervical root fracture', 'Up to 4 months'],
    ['Avulsion', '2 weeks'],
    ['Alveolar fracture', '4 weeks'],
  ],
};

const fractureSteps = [
  { icon: 'glass' as const, text: 'Rinse the mouth with water if there is bleeding.' },
  { icon: 'firstaid' as const, text: 'See a dentist as soon as possible — urgent care may be needed depending on the severity of the fracture.' },
];

const luxationSteps = [
  { icon: 'warning' as const, text: 'Try to move the tooth/teeth gently to the original position' },
  { icon: 'glass' as const, text: 'Close the mouth with a piece of clean napkin or gauze between the upper and lower front teeth' },
];

const avulsionSteps = [
  { icon: 'box' as const, text: 'Replant the tooth right away if possible.' },
  { icon: 'box' as const, text: 'If you cannot put it back in the socket, keep it in a safe storage medium until you see a dentist.' },
];

const storageOptions = [
  { icon: 'check' as const, text: "Hank's Balanced Salt Solution (HBSS), such as Save-A-Tooth®" },
  { icon: 'check' as const, text: 'Cold milk (Easier to get!)' },
  { icon: 'check' as const, text: 'Saline solution' },
  { icon: 'check' as const, text: 'Your own saliva (for short-term transport only)' },
];

const cbctFigures = [
  { src: '/images/treatments/dental-trauma/horizontal-root-fracture-periapical-illustration.webp', caption: 'Illustrative periapical view', alt: 'Illustrative periapical view of upper incisors depicting a transverse root fracture, based on a clinical reference' },
  { src: '/images/treatments/dental-trauma/horizontal-root-fracture-cbct-sagittal-1-illustration.webp', caption: 'Illustrative CBCT sagittal view 1', alt: 'Illustrative sagittal CBCT view of an upper incisor with a yellow arrow indicating a root fracture, view 1' },
  { src: '/images/treatments/dental-trauma/horizontal-root-fracture-cbct-sagittal-2-illustration.webp', caption: 'Illustrative CBCT sagittal view 2', alt: 'Illustrative sagittal CBCT view of an upper incisor with a yellow arrow indicating a root fracture, view 2' },
];

const faqs = [
  { q: 'How quickly can 562 endodontics see a trauma emergency?', a: 'Same-day appointments are available for acute trauma. Call <a href="tel:+15196013636" class="font-semibold text-brand-rust hover:underline">(519) 601-3636</a>. For avulsion cases, our team provides phone guidance to patients during transit to our office.' },
  { q: 'Does the consultation include CBCT imaging?', a: 'Yes. The consultation fee includes a CBCT scan, which is particularly valuable in trauma cases where 2D imaging may miss root fractures or underestimate the extent of injury.' },
  { q: 'Can a tooth infection occur months after trauma?', a: 'Yes. Infection may develop months or even years after the initial injury. Referral is advised if symptoms or radiographic changes appear.' },
  { q: 'Does 562 endodontics manage trauma in immature teeth?', a: 'Yes. Treatment options include vital pulp therapy, regenerative endodontic procedures, and apexification for teeth with open apices.' },
];

const ROW_PY = 'py-8 lg:py-10';
---

<BaseLayout
  title="Dental Trauma"
  description="Same-day dental trauma referrals in London, Ontario: assessment of fractures, luxation and avulsion injuries, splinting protocols, CBCT imaging and guidance for dentists and patients."
>
  <PageHero title="Dental Trauma" image={`/images/clinic/562-endodontics-london-ontario-treatment-room-overhead.webp`} />

  <!-- S2: Intro — texto a la izquierda, dos fotos apiladas a la derecha -->
  <IntroStacked
    topSrc={`/images/clinic/562-endodontics-london-ontario-clinic-building.webp`}
    topAlt="562 endodontics clinic building in London, Ontario"
    bottomSrc={`/images/team/562-endodontics-london-ontario-endodontists.webp`}
    bottomAlt="The 562 endodontics team of doctors"
  >
    <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Dental trauma management in London, Ontario</h2>
    <p class="mt-5 text-lg text-brand-ink/80">
      Dental trauma requires prompt assessment and appropriate clinical management. At 562 endodontics, our
      doctors accept same-day emergency referrals for dental injuries.
    </p>
    <p class="mt-4 text-lg text-brand-ink/80">
      Immediate management is important for diagnosis, stabilization, and follow-up planning. We welcome urgent
      referrals from dentists in London and Middlesex County.
    </p>
    <a href="#form" class="mt-7 inline-flex items-center gap-2 rounded-[20px_20px_3px_3px] bg-[#7F6E5D] px-7 py-3 font-heading text-sm font-semibold uppercase tracking-wide text-white transition hover:opacity-90">
      Contact Us <span aria-hidden="true">→</span>
    </a>
  </IntroStacked>

  <!-- S3: Clasificación -->
  <section class="bg-[#E3DBD4] py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Classification of traumatic dental injuries and endodontic relevance</h2>
      <p class="mt-4 text-lg text-brand-ink/80">
        Not all dental trauma requires immediate endodontic treatment. However, many injuries require close
        monitoring, as pulp necrosis and inflammatory root resorption may develop weeks or months after the initial
        injury.
      </p>
      <p class="mt-4 text-lg text-brand-ink/80">
        We encourage dentists to follow the recommended guidelines established by the
        <a href="https://onlinelibrary.wiley.com/toc/16009657/2024/40/S1" target="_blank" rel="noopener" class="font-semibold text-brand-rust underline hover:no-underline">International Association of Dental Traumatology</a>
        and American Association of Endodontists.
      </p>
      <p class="mt-4 text-lg font-semibold text-brand-ink">
        The following classification summarizes common traumatic dental injuries and their endodontic implications.
      </p>
      <div class="mt-8">
        <DataTable headers={injuryTable.headers} rows={injuryTable.rows} />
      </div>
      <p class="mt-8 text-lg text-brand-ink/80">Early evaluation supports timely diagnosis and treatment planning.</p>
    </div>
  </section>

  <!-- S4: Patient guide -->
  <section class="bg-white pb-4 pt-16 lg:pt-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Patient guide: Immediate Management of Dental Trauma</h2>
      <p class="mt-4 text-lg text-brand-ink/80">
        Dental injuries require prompt attention to maximize the chance of saving the tooth and preventing long-term
        problems.
      </p>
    </div>
  </section>

  <ImageRow imageSrc={`/images/treatments/dental-trauma/fractured-incisor-diagram.webp`} imageAlt="Educational illustration of a chipped upper incisor with a flat solid dentin fracture surface" py={ROW_PY}>
    <h3 class="font-heading text-2xl font-semibold text-brand-rust">Tooth Fractures</h3>
    <p class="mt-4 text-lg text-brand-ink/80">If a tooth chips or breaks, save any pieces and bring them with the patient.</p>
    <IconList items={fractureSteps} />
  </ImageRow>

  <div id="tooth-luxation" class="scroll-mt-28" aria-hidden="true"></div>
  <ImageRow imageSrc={`/images/treatments/dental-trauma/tooth-luxation-diagram.webp`} imageAlt="Educational illustration of a displaced upper central incisor beside normally aligned neighboring teeth" py={ROW_PY}>
    <h3 class="font-heading text-2xl font-semibold text-brand-rust">Tooth Luxation (Displacement)</h3>
    <p class="mt-4 text-lg text-brand-ink/80">
      A tooth that is pushed out of place, loose, or knocked sideways should be examined immediately by a dentist.
    </p>
    <IconList items={luxationSteps} />
  </ImageRow>

  <ImageRow imageSrc={`/images/treatments/dental-trauma/avulsed-tooth-diagram.webp`} imageAlt="Educational illustration of an empty upper central incisor socket following avulsion, with intact neighboring teeth" py={ROW_PY}>
    <h3 class="font-heading text-2xl font-semibold text-brand-rust">Tooth Avulsion (Knocked-Out Tooth)</h3>
    <p class="mt-4 text-lg text-brand-ink/80">
      A tooth that is completely knocked out is a serious injury. The faster it is treated, the better the chance of
      being saved.
    </p>
    <h4 class="mt-6 font-heading text-lg font-semibold text-brand-rust">What to do</h4>
    <IconList items={avulsionSteps} />
    <h4 class="mt-6 font-heading text-lg font-semibold text-brand-rust">Recommended storage options (best to worst):</h4>
    <IconList items={storageOptions} />
  </ImageRow>

  <!-- Barra de alerta -->
  <section class="bg-white py-8 lg:py-10">
    <div class="mx-auto max-w-6xl px-6">
      <p class="mx-auto max-w-[830px] bg-brand-rust px-6 py-4 text-center text-lg text-white">
        <strong class="font-semibold">Important:</strong> Avoid water if possible — it can damage the cells that help the tooth reattach.
      </p>
    </div>
  </section>

  <!-- Doctors Guide -->
  <SplitSection imageSrc={`/images/team/562-endodontics-london-ontario-endodontist-and-assistants-with-microscope.webp`} imageAlt="Doctor working with an operating microscope" imagePosition="right" bg="bg-white" imageAspect="aspect-[655/540]" py="pt-8 pb-16 lg:pt-10 lg:pb-20">
    <p class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Doctors Guide:</p>
    <h3 class="mt-2 font-heading text-2xl font-semibold text-brand-rust">Clinical Protocol &amp; Patient Instructions for Parents/Patients</h3>
    <p class="mt-5 text-lg text-brand-ink/80">
      Instruct the patient to handle the tooth by the crown only if possible. If contaminated, briefly rinse the tooth
      under cool running water without scrubbing the root surface.
    </p>
    <p class="mt-4 text-lg text-brand-ink/80">
      If possible, gently reposition the tooth into the socket and stabilize it by biting on gauze. If this is not
      possible, place the tooth in cold milk and seek immediate dental care.
    </p>
    <p class="mt-4 text-lg text-brand-ink/80">
      We can provide phone guidance for avulsion emergencies as the patient travels to the clinic.
    </p>
  </SplitSection>

  <!-- S5: Splinting -->
  <section class="bg-[#E3DBD4] py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Dental injuries and splinting protocol</h2>
      <p class="mt-4 text-lg text-brand-ink/80">
        We place and remove all splints at 562 endodontics. Splint type and duration depend on the type of injury. The
        table below outlines IADT 2020 durations and clinical notes for co-management.
      </p>
      <div class="mt-8">
        <DataTable headers={splintTable.headers} rows={splintTable.rows} />
      </div>
    </div>
  </section>

  <!-- S6: CBCT (banda roja) con galería de 3 ilustraciones -->
  <section class="bg-brand-rust py-16 text-white lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-heading text-3xl font-semibold leading-tight text-white sm:text-[32px]">Horizontal root fractures and the role of CBCT imaging</h2>
      <p class="mt-5 max-w-4xl text-lg text-white">
        Horizontal root fractures are often missed on conventional periapical radiographs if the X-ray beam is not
        aligned with the fracture plane.
      </p>
      <p class="mt-4 max-w-4xl text-lg text-white">
        Early CBCT evaluation improves diagnostic accuracy and reduces the risk of missed cervical root fractures, which
        may otherwise require extraction.
      </p>

      <div class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6" data-reveal-each>
        {cbctFigures.map((fig) => (
          <figure>
            <img src={fig.src} alt={fig.alt} class="aspect-[4/5] w-full rounded-[20px] object-cover shadow-md" loading="lazy" />
            <figcaption class="mt-3 text-lg font-semibold text-white">{fig.caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-6 text-lg text-white">
        Educational illustrations based on clinical reference images. These are not patient radiographs or diagnostic scans.
      </p>
    </div>
  </section>

  <!-- S7: Seguimiento (reemplaza a "Delayed trauma sequelae") -->
  <section id="follow-up" class="scroll-mt-28 bg-white py-14 lg:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-lg text-brand-ink/80">
        It is important for the patient to attend follow-up appointments and maintain regular dental visits, as
        traumatic dental injuries may develop delayed sequelae over time, including external cervical resorption, pulp
        canal obliteration, ankylosis, pulpal necrosis, and apical infection. Continued clinical and radiographic
        monitoring is essential for early detection and management of these complications.
      </p>
    </div>
  </section>

  <!-- S8: FAQ -->
  <section class="bg-[#E3DBD4]/50 py-16 lg:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center font-heading text-3xl font-semibold leading-tight text-brand-rust sm:text-[32px]">Frequently asked questions</h2>
      <div class="mt-10">
        <TreatmentFaq items={faqs} />
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
