# Envío de correo de los formularios (contact y referral) con el Microsoft 365 de la clínica,
# vía Microsoft Graph. Registro de aplicación de Azure con permiso de aplicación Mail.Send
# (consentimiento del administrador). Sin estas variables las API devuelven error en vez de
# fingir que enviaron el mensaje.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Buzón desde el que se envía y que recibe los avisos (opcional; por defecto info@562endodontics.com).
MAIL_FROM=info@562endodontics.com

# Cloudflare Turnstile (captcha de los formularios). Claves en dash.cloudflare.com > Turnstile.
# La clave pública va en la página; la secreta solo en el servidor. Para desarrollo local hay claves
# de prueba de Cloudflare: sitekey 1x00000000000000000000AA y secret 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
