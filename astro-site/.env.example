# Envío de correo de los formularios (contact y referral) con el Microsoft 365 de la clínica,
# vía Microsoft Graph. Registro de aplicación de Azure con permiso de aplicación Mail.Send
# (consentimiento del administrador). Sin estas variables las API devuelven error en vez de
# fingir que enviaron el mensaje.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Buzón desde el que se envía y que recibe los avisos (opcional; por defecto info@562endodontics.com).
MAIL_FROM=info@562endodontics.com

# Cloudflare Turnstile (captcha de los formularios). Claves en dash.cloudflare.com > Turnstile.
# La clave pública va en la página; la secreta solo en el servidor. Para desarrollo local hay claves
# de prueba de Cloudflare: sitekey 1x00000000000000000000AA y secret 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Aviso por correo al paciente (solo contacto de la clinica). Dejar vacio hasta que la clinica lo apruebe.
REFERRAL_NOTIFY_PATIENT=

# Archivos adjuntos del referral (radiografias, PDF): Vercel Blob PRIVADO. Se crea en Vercel > Storage > Create > Blob
# (Private) y se conecta al proyecto: Vercel agrega BLOB_READ_WRITE_TOKEN solo. Opcional: clave propia para firmar
# los enlaces de descarga (si no existe se usa BLOB_READ_WRITE_TOKEN).
BLOB_READ_WRITE_TOKEN=
REFERRAL_SIGNING_SECRET=

# Tarea semanal que borra archivos de referrals con mas de 12 meses. Vercel la autoriza con este secreto:
# cualquier texto largo y aleatorio.
CRON_SECRET=

# Suscriptores y referrals se guardan tambien en el WordPress (plugins wordpress/562-subscribers.php y
# wordpress/562-referrals.php, menus "Subscribers" y "Referrals"). Usan WP_API_URL (abajo) y este secreto,
# igual al ENDO562_API_SECRET de wp-config.php. Sin ellos solo se envian los correos a info@.
WP_API_SECRET=

# URL del WordPress que administra los datos de la clinica (telefono, correo, horario, direccion y PDF del referral); opcional.
# Sin ella el sitio usa src/data/site-settings.json. Ejemplo: https://cms.ejemplo.com
WP_API_URL=
